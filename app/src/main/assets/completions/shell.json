{
  "language": "shell",
  "version": 1,
  "items": [
    // ═══════════════════════════════════════════════════════
    // Keywords / Builtins (30)
    // ═══════════════════════════════════════════════════════
    { "name": "if", "kind": "keyword", "description": "شرط", "insert": "if [ $0 ]; then\n    $1\nfi", "priority": 10 },
    { "name": "if-else", "kind": "snippet", "description": "if-else", "insert": "if [ $0 ]; then\n    $1\nelse\n    $2\nfi", "priority": 10 },
    { "name": "if-elif", "kind": "snippet", "description": "if-elif-else", "insert": "if [ $0 ]; then\n    $1\nelif [ $2 ]; then\n    $3\nelse\n    $4\nfi", "priority": 9 },
    { "name": "for", "kind": "snippet", "description": "حلقة for", "insert": "for $0 in $1; do\n    $2\ndone", "priority": 10 },
    { "name": "for-c-style", "kind": "snippet", "description": "for بأسلوب C", "insert": "for ((i=0; i<$0; i++)); do\n    $1\ndone", "priority": 8 },
    { "name": "while", "kind": "snippet", "description": "حلقة while", "insert": "while [ $0 ]; do\n    $1\ndone", "priority": 9 },
    { "name": "until", "kind": "snippet", "description": "حلقة until", "insert": "until [ $0 ]; do\n    $1\ndone", "priority": 6 },
    { "name": "case", "kind": "snippet", "description": "case", "insert": "case $0 in\n    pattern1)\n        $1\n        ;;\n    pattern2)\n        $2\n        ;;\n    *)\n        $3\n        ;;\nesac", "priority": 8 },
    { "name": "function", "kind": "snippet", "description": "دالة", "insert": "$0() {\n    $1\n}", "priority": 10 },
    { "name": "function-keyword", "kind": "snippet", "description": "دالة بكلمة function", "insert": "function $0 {\n    $1\n}", "priority": 7 },
    { "name": "return", "kind": "keyword", "description": "إرجاع من دالة", "insert": "return $0", "priority": 8 },
    { "name": "exit", "kind": "keyword", "description": "خروج", "insert": "exit $0", "priority": 8 },
    { "name": "break", "kind": "keyword", "description": "خروج من الحلقة", "insert": "break", "priority": 8 },
    { "name": "continue", "kind": "keyword", "description": "متابعة الحلقة", "insert": "continue", "priority": 8 },
    { "name": "local", "kind": "keyword", "description": "متغير محلي", "insert": "local $0=$1", "priority": 8 },
    { "name": "export", "kind": "keyword", "description": "تصدير متغير", "insert": "export $0=$1", "priority": 8 },
    { "name": "readonly", "kind": "keyword", "description": "ثابت", "insert": "readonly $0=$1", "priority": 6 },
    { "name": "declare", "kind": "keyword", "description": "تعريف متغير", "insert": "declare $0=$1", "priority": 6 },
    { "name": "unset", "kind": "keyword", "description": "حذف متغير", "insert": "unset $0", "priority": 5 },
    { "name": "shift", "kind": "keyword", "description": "إزاحة المعاملات", "insert": "shift", "priority": 5 },
    { "name": "eval", "kind": "keyword", "description": "تقييم", "insert": "eval \"$0\"", "priority": 4 },
    { "name": "exec", "kind": "keyword", "description": "استبدال العملية", "insert": "exec $0", "priority": 4 },
    { "name": "source", "kind": "keyword", "description": "تضمين ملف", "insert": "source $0", "priority": 7 },
    { "name": "alias", "kind": "keyword", "description": "كنية", "insert": "alias $0='$1'", "priority": 6 },
    { "name": "trap", "kind": "keyword", "description": "مصيدة إشارة", "insert": "trap '$0' $1", "priority": 4 },
    { "name": "set -e", "kind": "snippet", "description": "توقف عند الخطأ", "insert": "set -e", "priority": 9 },
    { "name": "set -u", "kind": "snippet", "description": "خطأ عند متغير فارغ", "insert": "set -u", "priority": 8 },
    { "name": "set -x", "kind": "snippet", "description": "تتبع الأوامر", "insert": "set -x", "priority": 6 },
    { "name": "set -euo", "kind": "snippet", "description": "الإعدادات الآمنة الكاملة", "insert": "set -euo pipefail", "priority": 10 },
    { "name": "set -o pipefail", "kind": "snippet", "description": "خطأ في الأنابيب", "insert": "set -o pipefail", "priority": 8 },

    // Variables / Substitution (15)
    { "name": "$?", "kind": "value", "description": "كود خروج آخر أمر", "priority": 9 },
    { "name": "$#", "kind": "value", "description": "عدد المعاملات", "priority": 8 },
    { "name": "$@", "kind": "value", "description": "كل المعاملات", "priority": 9 },
    { "name": "$*", "kind": "value", "description": "كل المعاملات كنص واحد", "priority": 7 },
    { "name": "$0", "kind": "value", "description": "اسم السكربت", "priority": 8 },
    { "name": "$1", "kind": "value", "description": "المعامل الأول", "priority": 9 },
    { "name": "$$", "kind": "value", "description": "PID العملية الحالية", "priority": 6 },
    { "name": "$!", "kind": "value", "description": "PID آخر عملية في الخلفية", "priority": 6 },
    { "name": "${var:-default}", "kind": "snippet", "description": "قيمة افتراضية", "insert": "${$0:-$1}", "priority": 8 },
    { "name": "${var:=default}", "kind": "snippet", "description": "تعيين افتراضي", "insert": "${$0:=$1}", "priority": 6 },
    { "name": "${var:+value}", "kind": "snippet", "description": "قيمة بديلة", "insert": "${$0:+$1}", "priority": 5 },
    { "name": "${var#pattern}", "kind": "snippet", "description": "حذف من البداية", "insert": "${$0#$1}", "priority": 6 },
    { "name": "${var##pattern}", "kind": "snippet", "description": "حذف من البداية (جشع)", "insert": "${$0##$1}", "priority": 5 },
    { "name": "${var%pattern}", "kind": "snippet", "description": "حذف من النهاية", "insert": "${$0%$1}", "priority": 6 },
    { "name": "${var%%pattern}", "kind": "snippet", "description": "حذف من النهاية (جشع)", "insert": "${$0%%$1}", "priority": 5 },
    { "name": "${#var}", "kind": "snippet", "description": "طول المتغير", "insert": "${#$0}", "priority": 7 },
    { "name": "${var/a/b}", "kind": "snippet", "description": "استبدال أول", "insert": "${$0/$1/$2}", "priority": 6 },
    { "name": "${var//a/b}", "kind": "snippet", "description": "استبدال الكل", "insert": "${$0//$1/$2}", "priority": 6 },

    // Common Commands (35)
    { "name": "echo", "kind": "method", "description": "طباعة", "insert": "echo \"$0\"", "priority": 10 },
    { "name": "printf", "kind": "method", "description": "طباعة مُنسَّقة", "insert": "printf \"$0\\n\"", "priority": 8 },
    { "name": "read", "kind": "method", "description": "قراءة إدخال", "insert": "read -r $0", "priority": 9 },
    { "name": "read-prompt", "kind": "snippet", "description": "قراءة مع تلميح", "insert": "read -p \"$0: \" $1", "priority": 8 },
    { "name": "ls", "kind": "method", "description": "سرد الملفات", "insert": "ls -la $0", "priority": 9 },
    { "name": "cd", "kind": "method", "description": "تغيير المجلد", "insert": "cd $0", "priority": 9 },
    { "name": "pwd", "kind": "method", "description": "المجلد الحالي", "insert": "pwd", "priority": 8 },
    { "name": "mkdir", "kind": "method", "description": "إنشاء مجلد", "insert": "mkdir -p $0", "priority": 8 },
    { "name": "rm", "kind": "method", "description": "حذف", "insert": "rm -rf $0", "priority": 9 },
    { "name": "cp", "kind": "method", "description": "نسخ", "insert": "cp -r $0 $1", "priority": 8 },
    { "name": "mv", "kind": "method", "description": "نقل", "insert": "mv $0 $1", "priority": 8 },
    { "name": "touch", "kind": "method", "description": "إنشاء ملف فارغ", "insert": "touch $0", "priority": 8 },
    { "name": "cat", "kind": "method", "description": "عرض ملف", "insert": "cat $0", "priority": 9 },
    { "name": "head", "kind": "method", "description": "أول أسطر", "insert": "head -n $0 $1", "priority": 8 },
    { "name": "tail", "kind": "method", "description": "آخر أسطر", "insert": "tail -n $0 $1", "priority": 8 },
    { "name": "tail -f", "kind": "method", "description": "متابعة ملف", "insert": "tail -f $0", "priority": 7 },
    { "name": "grep", "kind": "method", "description": "بحث في النص", "insert": "grep -r \"$0\" $1", "priority": 10 },
    { "name": "grep-case", "kind": "snippet", "description": "بحث غير حساس", "insert": "grep -ri \"$0\" $1", "priority": 7 },
    { "name": "sed", "kind": "method", "description": "تحرير نصي", "insert": "sed -i 's/$0/$1/g' $2", "priority": 8 },
    { "name": "awk", "kind": "method", "description": "معالجة نص", "insert": "awk '{print $0}' $1", "priority": 8 },
    { "name": "cut", "kind": "method", "description": "قطع حقول", "insert": "cut -d '$0' -f $1", "priority": 7 },
    { "name": "sort", "kind": "method", "description": "ترتيب", "insert": "sort $0", "priority": 8 },
    { "name": "uniq", "kind": "method", "description": "إزالة التكرار", "insert": "uniq $0", "priority": 7 },
    { "name": "wc", "kind": "method", "description": "عدّ", "insert": "wc -l $0", "priority": 8 },
    { "name": "find", "kind": "method", "description": "بحث عن ملفات", "insert": "find $0 -name \"$1\"", "priority": 9 },
    { "name": "xargs", "kind": "method", "description": "تمرير كمعاملات", "insert": "xargs -I {} $0", "priority": 6 },
    { "name": "chmod", "kind": "method", "description": "تغيير الأذونات", "insert": "chmod +x $0", "priority": 8 },
    { "name": "chown", "kind": "method", "description": "تغيير المالك", "insert": "chown $0:$1 $2", "priority": 6 },
    { "name": "basename", "kind": "method", "description": "اسم الملف", "insert": "basename $0", "priority": 7 },
    { "name": "dirname", "kind": "method", "description": "مسار المجلد", "insert": "dirname $0", "priority": 7 },
    { "name": "realpath", "kind": "method", "description": "المسار المطلق", "insert": "realpath $0", "priority": 6 },
    { "name": "tar", "kind": "method", "description": "أرشفة", "insert": "tar -czvf $0.tar.gz $1", "priority": 7 },
    { "name": "tar-extract", "kind": "snippet", "description": "استخراج", "insert": "tar -xzvf $0", "priority": 6 },
    { "name": "curl", "kind": "method", "description": "طلب HTTP", "insert": "curl -sSL $0", "priority": 8 },
    { "name": "curl-download", "kind": "snippet", "description": "تنزيل ملف", "insert": "curl -L -o $0 $1", "priority": 7 },
    { "name": "curl-json", "kind": "snippet", "description": "POST JSON", "insert": "curl -X POST -H \"Content-Type: application/json\" -d '$0' $1", "priority": 6 },
    { "name": "wget", "kind": "method", "description": "تنزيل", "insert": "wget $0", "priority": 7 },
    { "name": "ssh", "kind": "method", "description": "اتصال SSH", "insert": "ssh $0@$1", "priority": 6 },
    { "name": "scp", "kind": "method", "description": "نسخ عبر SSH", "insert": "scp $0 $1:$2", "priority": 5 },
    { "name": "ps", "kind": "method", "description": "العمليات", "insert": "ps aux | grep $0", "priority": 7 },
    { "name": "kill", "kind": "method", "description": "إنهاء عملية", "insert": "kill -9 $0", "priority": 7 },
    { "name": "sleep", "kind": "method", "description": "انتظار", "insert": "sleep $0", "priority": 7 },
    { "name": "date", "kind": "method", "description": "التاريخ", "insert": "date +\"$0\"", "priority": 6 },
    { "name": "env", "kind": "method", "description": "متغيرات البيئة", "insert": "env | grep $0", "priority": 6 },
    { "name": "which", "kind": "method", "description": "موقع الأمر", "insert": "which $0", "priority": 6 },
    { "name": "command -v", "kind": "snippet", "description": "فحص وجود أمر", "insert": "command -v $0 >/dev/null 2>&1", "priority": 7 },

    // Snippets (20)
    { "name": "shebang-bash", "kind": "snippet", "description": "shebang Bash", "insert": "#!/usr/bin/env bash\n\nset -euo pipefail\n\n$0", "priority": 10 },
    { "name": "shebang-sh", "kind": "snippet", "description": "shebang sh", "insert": "#!/bin/sh\n\n$0", "priority": 8 },
    { "name": "strict-mode", "kind": "snippet", "description": "الوضع الصارم", "insert": "set -euo pipefail\nIFS=$'\\n\\t'", "priority": 7 },
    { "name": "check-arg", "kind": "snippet", "description": "فحص معامل", "insert": "if [ $# -lt $0 ]; then\n    echo \"Usage: $1\" >&2\n    exit 1\nfi", "priority": 7 },
    { "name": "check-file", "kind": "snippet", "description": "فحص وجود ملف", "insert": "if [ -f \"$0\" ]; then\n    $1\nfi", "priority": 8 },
    { "name": "check-dir", "kind": "snippet", "description": "فحص وجود مجلد", "insert": "if [ -d \"$0\" ]; then\n    $1\nfi", "priority": 8 },
    { "name": "check-cmd", "kind": "snippet", "description": "فحص وجود أمر", "insert": "if command -v $0 >/dev/null 2>&1; then\n    $1\nelse\n    echo \"$0 not found\" >&2\n    exit 1\nfi", "priority": 6 },
    { "name": "log-info", "kind": "snippet", "description": "طباعة معلومة", "insert": "echo \"[INFO] $0\"", "priority": 8 },
    { "name": "log-error", "kind": "snippet", "description": "طباعة خطأ", "insert": "echo \"[ERROR] $0\" >&2", "priority": 8 },
    { "name": "log-warn", "kind": "snippet", "description": "طباعة تحذير", "insert": "echo \"[WARN] $0\" >&2", "priority": 7 },
    { "name": "trap-cleanup", "kind": "snippet", "description": "تنظيف عند الخروج", "insert": "cleanup() {\n    $0\n}\ntrap cleanup EXIT", "priority": 7 },
    { "name": "read-array", "kind": "snippet", "description": "قراءة مصفوفة", "insert": "mapfile -t $0 < <(command)", "priority": 5 },
    { "name": "array-declare", "kind": "snippet", "description": "مصفوفة", "insert": "$0=($1 $2 $3)", "priority": 7 },
    { "name": "array-loop", "kind": "snippet", "description": "حلقة على مصفوفة", "insert": "for item in \"${'$'}{$0[@]}\"; do\n    echo \"$item\"\ndone", "priority": 7 },
    { "name": "temp-file", "kind": "snippet", "description": "ملف مؤقت", "insert": "$0=$(mktemp)\ntrap 'rm -f \"$0\"' EXIT", "priority": 6 },
    { "name": "here-doc", "kind": "snippet", "description": "Here Document", "insert": "cat <<EOF\n$0\nEOF", "priority": 6 },
    { "name": "here-string", "kind": "snippet", "description": "Here String", "insert": "$0 <<< \"$1\"", "priority": 5 },
    { "name": "if-numeric", "kind": "snippet", "description": "مقارنة رقمية", "insert": "if [ \"$0\" -gt $1 ]; then\n    $2\nfi", "priority": 6 },
    { "name": "if-string", "kind": "snippet", "description": "مقارنة نصية", "insert": "if [ \"$0\" = \"$1\" ]; then\n    $2\nfi", "priority": 6 },
    { "name": "parallel-jobs", "kind": "snippet", "description": "مهام متوازية", "insert": "for item in \"${'$'}@\"; do\n    $0 \"$item\" &\ndone\nwait", "priority": 4 }
  ]
}