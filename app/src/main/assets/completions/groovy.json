{
  "language": "groovy",
  "version": 1,
  "items": [
    // ═══════════════════════════════════════════════════════
    // Gradle Keywords / DSL (40)
    // ═══════════════════════════════════════════════════════
    { "name": "plugins", "kind": "keyword", "description": "الإضافات", "insert": "plugins {\n    $0\n}", "priority": 10 },
    { "name": "dependencies", "kind": "keyword", "description": "الاعتماديات", "insert": "dependencies {\n    $0\n}", "priority": 10 },
    { "name": "repositories", "kind": "keyword", "description": "المستودعات", "insert": "repositories {\n    google()\n    mavenCentral()\n}", "priority": 10 },
    { "name": "allprojects", "kind": "keyword", "description": "كل المشاريع", "insert": "allprojects {\n    $0\n}", "priority": 8 },
    { "name": "subprojects", "kind": "keyword", "description": "المشاريع الفرعية", "insert": "subprojects {\n    $0\n}", "priority": 8 },
    { "name": "buildscript", "kind": "keyword", "description": "سكربت البناء", "insert": "buildscript {\n    repositories {\n        google()\n        mavenCentral()\n    }\n    dependencies {\n        $0\n    }\n}", "priority": 9 },
    { "name": "android", "kind": "keyword", "description": "كتلة Android", "insert": "android {\n    $0\n}", "priority": 10 },
    { "name": "defaultConfig", "kind": "keyword", "description": "الإعدادات الافتراضية", "insert": "defaultConfig {\n    applicationId \"$0\"\n    minSdk $1\n    targetSdk $2\n    versionCode $3\n    versionName \"$4\"\n}", "priority": 10 },
    { "name": "buildTypes", "kind": "keyword", "description": "أنواع البناء", "insert": "buildTypes {\n    release {\n        minifyEnabled false\n        proguardFiles getDefaultProguardFile('proguard-android-optimize.txt'), 'proguard-rules.pro'\n    }\n}", "priority": 9 },
    { "name": "compileOptions", "kind": "keyword", "description": "إعدادات التحويل البرمجي", "insert": "compileOptions {\n    sourceCompatibility JavaVersion.VERSION_17\n    targetCompatibility JavaVersion.VERSION_17\n}", "priority": 8 },
    { "name": "kotlinOptions", "kind": "keyword", "description": "إعدادات Kotlin", "insert": "kotlinOptions {\n    jvmTarget = '17'\n}", "priority": 8 },
    { "name": "sourceSets", "kind": "keyword", "description": "مجموعات المصادر", "insert": "sourceSets {\n    main {\n        java.srcDirs = ['src/main/java']\n        res.srcDirs = ['src/main/res']\n    }\n}", "priority": 7 },
    { "name": "signingConfigs", "kind": "keyword", "description": "إعدادات التوقيع", "insert": "signingConfigs {\n    release {\n        storeFile file('$0')\n        storePassword '$1'\n        keyAlias '$2'\n        keyPassword '$3'\n    }\n}", "priority": 7 },
    { "name": "flavorDimensions", "kind": "keyword", "description": "أبعاد النكهات", "insert": "flavorDimensions \"$0\"", "priority": 6 },
    { "name": "productFlavors", "kind": "keyword", "description": "النكهات", "insert": "productFlavors {\n    $0 {\n        dimension \"$1\"\n    }\n}", "priority": 6 },
    { "name": "packagingOptions", "kind": "keyword", "description": "خيارات الحزم", "insert": "packagingOptions {\n    resources {\n        excludes += ['$0']\n    }\n}", "priority": 5 },
    { "name": "lint", "kind": "keyword", "description": "إعدادات lint", "insert": "lint {\n    abortOnError false\n}", "priority": 5 },
    { "name": "compileSdk", "kind": "keyword", "description": "إصدار الترجمة", "insert": "compileSdk $0", "priority": 10 },
    { "name": "minSdk", "kind": "keyword", "description": "أدنى إصدار", "insert": "minSdk $0", "priority": 10 },
    { "name": "targetSdk", "kind": "keyword", "description": "إصدار الهدف", "insert": "targetSdk $0", "priority": 10 },
    { "name": "versionCode", "kind": "keyword", "description": "رقم الإصدار", "insert": "versionCode $0", "priority": 9 },
    { "name": "versionName", "kind": "keyword", "description": "اسم الإصدار", "insert": "versionName \"$0\"", "priority": 9 },
    { "name": "applicationId", "kind": "keyword", "description": "معرّف التطبيق", "insert": "applicationId \"$0\"", "priority": 10 },
    { "name": "namespace", "kind": "keyword", "description": "فضاء الأسماء", "insert": "namespace \"$0\"", "priority": 10 },
    { "name": "buildToolsVersion", "kind": "keyword", "description": "إصدار أدوات البناء", "insert": "buildToolsVersion \"$0\"", "priority": 6 },
    { "name": "minifyEnabled", "kind": "keyword", "description": "تفعيل minify", "insert": "minifyEnabled false", "priority": 7 },
    { "name": "shrinkResources", "kind": "keyword", "description": "تقليص الموارد", "insert": "shrinkResources true", "priority": 5 },
    { "name": "multiDexEnabled", "kind": "keyword", "description": "multi-dex", "insert": "multiDexEnabled true", "priority": 6 },
    { "name": "vectorDrawables", "kind": "keyword", "description": "أيقونات vector", "insert": "vectorDrawables.useSupportLibrary = true", "priority": 5 },
    { "name": "buildFeatures", "kind": "keyword", "description": "ميزات البناء", "insert": "buildFeatures {\n    viewBinding true\n}", "priority": 7 },
    { "name": "viewBinding", "kind": "keyword", "description": "view binding", "insert": "viewBinding true", "priority": 7 },
    { "name": "dataBinding", "kind": "keyword", "description": "data binding", "insert": "dataBinding true", "priority": 6 },
    { "name": "testOptions", "kind": "keyword", "description": "خيارات الاختبار", "insert": "testOptions {\n    unitTests.returnDefaultValues = true\n}", "priority": 5 },
    { "name": "task", "kind": "keyword", "description": "مهمة", "insert": "task $0 {\n    doLast {\n        $1\n    }\n}", "priority": 8 },
    { "name": "tasks.register", "kind": "keyword", "description": "تسجيل مهمة", "insert": "tasks.register('$0') {\n    $1\n}", "priority": 8 },
    { "name": "subprojects-config", "kind": "keyword", "description": "config لكل مشروع فرعي", "insert": "subprojects {\n    afterEvaluate { project ->\n        $0\n    }\n}", "priority": 5 },
    { "name": "ext", "kind": "keyword", "description": "خصائص إضافية", "insert": "ext {\n    $0 = $1\n}", "priority": 7 },
    { "name": "project.ext", "kind": "keyword", "description": "خصائص المشروع", "insert": "project.ext.$0 = $1", "priority": 6 },
    { "name": "allprojects-repos", "kind": "keyword", "description": "مستودعات الكل", "insert": "allprojects {\n    repositories {\n        google()\n        mavenCentral()\n    }\n}", "priority": 7 },
    { "name": "gradle-wrapper", "kind": "snippet", "description": "wrapper task", "insert": "tasks.named('wrapper') {\n    gradleVersion = '$0'\n    distributionType = Wrapper.DistributionType.ALL\n}", "priority": 5 },

    // Dependencies
    { "name": "implementation", "kind": "keyword", "description": "اعتمادية تنفيذ", "insert": "implementation '$0'", "priority": 10 },
    { "name": "api", "kind": "keyword", "description": "اعتمادية API", "insert": "api '$0'", "priority": 8 },
    { "name": "compileOnly", "kind": "keyword", "description": "للتجميع فقط", "insert": "compileOnly '$0'", "priority": 7 },
    { "name": "runtimeOnly", "kind": "keyword", "description": "للتشغيل فقط", "insert": "runtimeOnly '$0'", "priority": 6 },
    { "name": "testImplementation", "kind": "keyword", "description": "اعتمادية الاختبارات", "insert": "testImplementation '$0'", "priority": 8 },
    { "name": "androidTestImplementation", "kind": "keyword", "description": "اعتمادية اختبارات أندرويد", "insert": "androidTestImplementation '$0'", "priority": 7 },
    { "name": "debugImplementation", "kind": "keyword", "description": "اعتمادية debug", "insert": "debugImplementation '$0'", "priority": 6 },
    { "name": "releaseImplementation", "kind": "keyword", "description": "اعتمادية release", "insert": "releaseImplementation '$0'", "priority": 5 },
    { "name": "classpath", "kind": "keyword", "description": "اعتمادية classpath", "insert": "classpath '$0'", "priority": 7 },
    { "name": "fileTree", "kind": "keyword", "description": "شجرة ملفات", "insert": "implementation fileTree(dir: 'libs', include: ['*.jar'])", "priority": 6 },
    { "name": "dep-flutter", "kind": "snippet", "description": "اعتمادية Flutter", "insert": "implementation \"org.jetbrains.kotlin:kotlin-stdlib-jdk7:${'$'}kotlin_version\"", "priority": 5 },

    // Plugin IDs (common)
    { "name": "com.android.application", "kind": "value", "description": "plugin تطبيق Android", "insert": "id 'com.android.application'", "priority": 9 },
    { "name": "com.android.library", "kind": "value", "description": "plugin مكتبة Android", "insert": "id 'com.android.library'", "priority": 8 },
    { "name": "org.jetbrains.kotlin.android", "kind": "value", "description": "plugin Kotlin Android", "insert": "id 'org.jetbrains.kotlin.android'", "priority": 9 },
    { "name": "kotlin-android", "kind": "value", "description": "plugin kotlin-android (قديم)", "insert": "id 'kotlin-android'", "priority": 7 },
    { "name": "dev.flutter.flutter-gradle-plugin", "kind": "value", "description": "plugin Flutter", "insert": "id 'dev.flutter.flutter-gradle-plugin'", "priority": 8 },
    { "name": "com.google.gms.google-services", "kind": "value", "description": "plugin Firebase", "insert": "id 'com.google.gms.google-services'", "priority": 7 },

    // Gradle properties
    { "name": "jvmargs", "kind": "keyword", "description": "خيارات JVM", "insert": "org.gradle.jvmargs=-Xmx2048m", "priority": 7 },
    { "name": "useAndroidX", "kind": "keyword", "description": "AndroidX", "insert": "android.useAndroidX=true", "priority": 8 },
    { "name": "enableJetifier", "kind": "keyword", "description": "Jetifier", "insert": "android.enableJetifier=true", "priority": 7 },
    { "name": "nonTransitiveRClass", "kind": "keyword", "description": "R class غير تعدي", "insert": "android.nonTransitiveRClass=true", "priority": 6 },
    { "name": "org.gradle.parallel", "kind": "keyword", "description": "بناء متوازي", "insert": "org.gradle.parallel=true", "priority": 6 },
    { "name": "org.gradle.caching", "kind": "keyword", "description": "تخزين مؤقت", "insert": "org.gradle.caching=true", "priority": 6 },
    { "name": "org.gradle.configureondemand", "kind": "keyword", "description": "config on demand", "insert": "org.gradle.configureondemand=true", "priority": 5 },
    { "name": "org.gradle.daemon", "kind": "keyword", "description": "daemon", "insert": "org.gradle.daemon=true", "priority": 5 },

    // Groovy Language
    { "name": "def", "kind": "keyword", "description": "تعريف متغير/دالة", "insert": "def $0 = $1", "priority": 10 },
    { "name": "if", "kind": "snippet", "description": "if", "insert": "if ($0) {\n    $1\n}", "priority": 10 },
    { "name": "if-else", "kind": "snippet", "description": "if-else", "insert": "if ($0) {\n    $1\n} else {\n    $2\n}", "priority": 9 },
    { "name": "for", "kind": "snippet", "description": "for-in", "insert": "for (item in $0) {\n    $1\n}", "priority": 9 },
    { "name": "while", "kind": "snippet", "description": "while", "insert": "while ($0) {\n    $1\n}", "priority": 7 },
    { "name": "switch", "kind": "snippet", "description": "switch", "insert": "switch ($0) {\n    case $1:\n        $2\n        break\n    default:\n        $3\n}", "priority": 6 },
    { "name": "try-catch", "kind": "snippet", "description": "try-catch", "insert": "try {\n    $0\n} catch (Exception e) {\n    e.printStackTrace()\n}", "priority": 8 },
    { "name": "try-finally", "kind": "snippet", "description": "try-finally", "insert": "try {\n    $0\n} finally {\n    $1\n}", "priority": 6 },
    { "name": "class", "kind": "snippet", "description": "class", "insert": "class $0 {\n    $1\n}", "priority": 8 },
    { "name": "interface", "kind": "snippet", "description": "interface", "insert": "interface $0 {\n    $1\n}", "priority": 6 },
    { "name": "trait", "kind": "snippet", "description": "trait", "insert": "trait $0 {\n    $1\n}", "priority": 5 },
    { "name": "enum", "kind": "snippet", "description": "enum", "insert": "enum $0 {\n    $1\n}", "priority": 6 },
    { "name": "closure", "kind": "snippet", "description": "closure", "insert": "{ $0 -> $1 }", "priority": 9 },
    { "name": "closure-it", "kind": "snippet", "description": "closure with it", "insert": "{ it -> $0 }", "priority": 8 },
    { "name": "println", "kind": "method", "description": "طباعة", "insert": "println \"$0\"", "priority": 10 },
    { "name": "print", "kind": "method", "description": "طباعة بدون سطر", "insert": "print \"$0\"", "priority": 8 },
    { "name": "each", "kind": "method", "description": "تكرار على مجموعة", "insert": "list.each { item ->\n    $0\n}", "priority": 8 },
    { "name": "collect", "kind": "method", "description": "تحويل مجموعة", "insert": "list.collect { it -> $0 }", "priority": 7 },
    { "name": "findAll", "kind": "method", "description": "تصفية", "insert": "list.findAll { it -> $0 }", "priority": 7 },
    { "name": "find", "kind": "method", "description": "أول مطابق", "insert": "list.find { it -> $0 }", "priority": 6 },
    { "name": "any", "kind": "method", "description": "هل أي", "insert": "list.any { it -> $0 }", "priority": 6 },
    { "name": "every", "kind": "method", "description": "هل الكل", "insert": "list.every { it -> $0 }", "priority": 6 },
    { "name": "inject", "kind": "method", "description": "تقليص", "insert": "list.inject($0) { acc, item -> $1 }", "priority": 5 },
    { "name": "sort", "kind": "method", "description": "ترتيب", "insert": "list.sort { a, b -> $0 }", "priority": 6 },
    { "name": "reverse", "kind": "method", "description": "عكس", "insert": "list.reverse()", "priority": 5 },
    { "name": "unique", "kind": "method", "description": "بدون تكرار", "insert": "list.unique()", "priority": 5 },
    { "name": "join", "kind": "method", "description": "دمج", "insert": "list.join('$0')", "priority": 5 },
    { "name": "size", "kind": "method", "description": "الحجم", "insert": "list.size()", "priority": 6 },

    // Common Snippets
    { "name": "if-null", "kind": "snippet", "description": "فحص null", "insert": "if ($0 != null) {\n    $1\n}", "priority": 6 },
    { "name": "elvis", "kind": "snippet", "description": "Elvis operator", "insert": "$0 ?: $1", "priority": 7 },
    { "name": "safe-nav", "kind": "snippet", "description": "safe navigation", "insert": "$0?.$1", "priority": 6 },
    { "name": "string-gstring", "kind": "snippet", "description": "GString", "insert": "\"Hello ${'$'}{$0}\"", "priority": 7 }
  ]
}