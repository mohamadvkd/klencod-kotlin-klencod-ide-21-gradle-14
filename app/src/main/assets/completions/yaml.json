{
  "language": "yaml",
  "version": 1,
  "items": [
    // ═══════════════════════════════════════════════════════
    // GitHub Actions (40)
    // ═══════════════════════════════════════════════════════
    { "name": "workflow", "kind": "snippet", "description": "هيكل workflow كامل", "insert": "name: $0\n\non:\n  workflow_dispatch:\n\njobs:\n  build:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n", "priority": 10 },
    { "name": "name", "kind": "keyword", "description": "اسم workflow", "insert": "name: $0", "priority": 10 },
    { "name": "on", "kind": "keyword", "description": "المُشغِّل", "insert": "on: $0", "priority": 10 },
    { "name": "on-push", "kind": "snippet", "description": "عند الدفع", "insert": "on:\n  push:\n    branches: [$0]", "priority": 9 },
    { "name": "on-pr", "kind": "snippet", "description": "عند PR", "insert": "on:\n  pull_request:\n    branches: [$0]", "priority": 9 },
    { "name": "on-dispatch", "kind": "snippet", "description": "تشغيل يدوي", "insert": "on:\n  workflow_dispatch:", "priority": 10 },
    { "name": "on-dispatch-inputs", "kind": "snippet", "description": "تشغيل يدوي مع inputs", "insert": "on:\n  workflow_dispatch:\n    inputs:\n      $0:\n        description: '$1'\n        required: true\n        default: '$2'", "priority": 9 },
    { "name": "on-schedule", "kind": "snippet", "description": "جدولة", "insert": "on:\n  schedule:\n    - cron: '$0'", "priority": 7 },
    { "name": "jobs", "kind": "keyword", "description": "الوظائف", "insert": "jobs:\n  $0:", "priority": 10 },
    { "name": "runs-on", "kind": "keyword", "description": "بيئة التشغيل", "insert": "runs-on: ubuntu-latest", "priority": 10 },
    { "name": "runs-on-matrix", "kind": "snippet", "description": "بيئة مع matrix", "insert": "runs-on: ${'$'}{{ matrix.os }}\nstrategy:\n  matrix:\n    os: [ubuntu-latest, macos-latest, windows-latest]", "priority": 8 },
    { "name": "steps", "kind": "keyword", "description": "الخطوات", "insert": "steps:\n  - name: $0\n    run: $1", "priority": 10 },
    { "name": "step-uses", "kind": "snippet", "description": "خطوة uses", "insert": "- name: $0\n  uses: $1\n  with:\n    $2", "priority": 10 },
    { "name": "step-run", "kind": "snippet", "description": "خطوة run", "insert": "- name: $0\n  run: |\n    $1", "priority": 10 },
    { "name": "uses-checkout", "kind": "snippet", "description": "actions/checkout", "insert": "- uses: actions/checkout@v4\n  with:\n    fetch-depth: 1", "priority": 10 },
    { "name": "uses-setup-java", "kind": "snippet", "description": "setup-java", "insert": "- uses: actions/setup-java@v4\n  with:\n    distribution: temurin\n    java-version: '17'", "priority": 10 },
    { "name": "uses-setup-node", "kind": "snippet", "description": "setup-node", "insert": "- uses: actions/setup-node@v4\n  with:\n    node-version: '20'\n    cache: 'npm'", "priority": 9 },
    { "name": "uses-setup-flutter", "kind": "snippet", "description": "setup-flutter", "insert": "- uses: subosito/flutter-action@v2\n  with:\n    flutter-version: '3.47.2'\n    channel: stable\n    cache: true", "priority": 9 },
    { "name": "uses-setup-python", "kind": "snippet", "description": "setup-python", "insert": "- uses: actions/setup-python@v5\n  with:\n    python-version: '3.12'", "priority": 8 },
    { "name": "uses-setup-android", "kind": "snippet", "description": "setup-android", "insert": "- uses: android-actions/setup-android@v3", "priority": 8 },
    { "name": "uses-cache", "kind": "snippet", "description": "cache", "insert": "- uses: actions/cache@v4\n  with:\n    path: $0\n    key: ${'$'}{{ runner.os }}-${'$'}{{ hashFiles('$1') }}", "priority": 8 },
    { "name": "uses-upload-artifact", "kind": "snippet", "description": "upload-artifact", "insert": "- uses: actions/upload-artifact@v4\n  with:\n    name: $0\n    path: $1\n    if-no-files-found: error\n    retention-days: 7", "priority": 9 },
    { "name": "uses-download-artifact", "kind": "snippet", "description": "download-artifact", "insert": "- uses: actions/download-artifact@v4\n  with:\n    name: $0", "priority": 7 },
    { "name": "uses-gradle", "kind": "snippet", "description": "gradle/actions", "insert": "- uses: gradle/actions/setup-gradle@v4\n  with:\n    gradle-version: $0", "priority": 8 },
    { "name": "uses-codecov", "kind": "snippet", "description": "codecov", "insert": "- uses: codecov/codecov-action@v4", "priority": 5 },
    { "name": "permissions", "kind": "keyword", "description": "الصلاحيات", "insert": "permissions:\n  contents: read", "priority": 8 },
    { "name": "permissions-write", "kind": "snippet", "description": "صلاحيات كتابة", "insert": "permissions:\n  contents: write\n  packages: write", "priority": 7 },
    { "name": "concurrency", "kind": "keyword", "description": "التزامن", "insert": "concurrency:\n  group: $0-${'$'}{{ github.ref }}\n  cancel-in-progress: true", "priority": 7 },
    { "name": "env", "kind": "keyword", "description": "متغيرات البيئة", "insert": "env:\n  $0: $1", "priority": 8 },
    { "name": "defaults", "kind": "keyword", "description": "القيم الافتراضية", "insert": "defaults:\n  run:\n    shell: bash", "priority": 6 },
    { "name": "strategy", "kind": "keyword", "description": "الاستراتيجية", "insert": "strategy:\n  fail-fast: false\n  matrix:\n    $0: [$1]", "priority": 7 },
    { "name": "if-condition", "kind": "snippet", "description": "شرط if", "insert": "if: ${'$'}{{ $0 }}", "priority": 8 },
    { "name": "if-success", "kind": "snippet", "description": "عند النجاح", "insert": "if: success()", "priority": 7 },
    { "name": "if-failure", "kind": "snippet", "description": "عند الفشل", "insert": "if: failure()", "priority": 8 },
    { "name": "if-always", "kind": "snippet", "description": "دائماً", "insert": "if: always()", "priority": 6 },
    { "name": "needs", "kind": "keyword", "description": "الاعتماديات", "insert": "needs: [$0]", "priority": 7 },
    { "name": "timeout-minutes", "kind": "keyword", "description": "مهلة الوظيفة", "insert": "timeout-minutes: $0", "priority": 6 },
    { "name": "container", "kind": "keyword", "description": "حاوية", "insert": "container:\n  image: $0", "priority": 5 },
    { "name": "outputs", "kind": "keyword", "description": "المخرجات", "insert": "outputs:\n  $0: ${'$'}{{ steps.$1.outputs.$2 }}", "priority": 6 },

    // GitHub Context Expressions
    { "name": "github.sha", "kind": "value", "description": "SHA الحالي", "insert": "${'$'}{{ github.sha }}", "priority": 6 },
    { "name": "github.ref", "kind": "value", "description": "الفرع/المرجع", "insert": "${'$'}{{ github.ref }}", "priority": 7 },
    { "name": "github.ref_name", "kind": "value", "description": "اسم الفرع", "insert": "${'$'}{{ github.ref_name }}", "priority": 6 },
    { "name": "github.repository", "kind": "value", "description": "المستودع", "insert": "${'$'}{{ github.repository }}", "priority": 6 },
    { "name": "github.event_name", "kind": "value", "description": "اسم الحدث", "insert": "${'$'}{{ github.event_name }}", "priority": 5 },
    { "name": "github.event.inputs", "kind": "value", "description": "مدخلات الحدث", "insert": "${'$'}{{ github.event.inputs.$0 }}", "priority": 8 },
    { "name": "github.workspace", "kind": "value", "description": "مساحة العمل", "insert": "${'$'}{{ github.workspace }}", "priority": 6 },
    { "name": "runner.os", "kind": "value", "description": "نظام التشغيل", "insert": "${'$'}{{ runner.os }}", "priority": 5 },
    { "name": "runner.temp", "kind": "value", "description": "مجلد مؤقت", "insert": "${'$'}{{ runner.temp }}", "priority": 5 },
    { "name": "secrets.GITHUB_TOKEN", "kind": "value", "description": "توكن GitHub", "insert": "${'$'}{{ secrets.GITHUB_TOKEN }}", "priority": 7 },
    { "name": "secrets", "kind": "value", "description": "سر", "insert": "${'$'}{{ secrets.$0 }}", "priority": 8 },
    { "name": "env", "kind": "value", "description": "متغير بيئة", "insert": "${'$'}{{ env.$0 }}", "priority": 7 },
    { "name": "matrix", "kind": "value", "description": "قيمة matrix", "insert": "${'$'}{{ matrix.$0 }}", "priority": 7 },
    { "name": "steps.outputs", "kind": "value", "description": "مخرجات خطوة", "insert": "${'$'}{{ steps.$0.outputs.$1 }}", "priority": 7 },
    { "name": "hashFiles", "kind": "value", "description": "هاش الملفات", "insert": "${'$'}{{ hashFiles('$0') }}", "priority": 6 },

    // pubspec.yaml (Flutter) — 15
    { "name": "pubspec-basic", "kind": "snippet", "description": "pubspec أساسي", "insert": "name: $0\ndescription: $1\npublish_to: 'none'\nversion: 1.0.0+1\n\nenvironment:\n  sdk: '>=3.0.0 <4.0.0'\n\ndependencies:\n  flutter:\n    sdk: flutter\n\nflutter:\n  uses-material-design: true", "priority": 10 },
    { "name": "pubspec-name", "kind": "keyword", "description": "اسم الحزمة", "insert": "name: $0", "priority": 10 },
    { "name": "pubspec-description", "kind": "keyword", "description": "الوصف", "insert": "description: $0", "priority": 9 },
    { "name": "pubspec-version", "kind": "keyword", "description": "الإصدار", "insert": "version: $0", "priority": 9 },
    { "name": "publish_to", "kind": "keyword", "description": "منع النشر", "insert": "publish_to: 'none'", "priority": 8 },
    { "name": "environment", "kind": "keyword", "description": "البيئة", "insert": "environment:\n  sdk: '$0'", "priority": 9 },
    { "name": "dependencies", "kind": "keyword", "description": "الاعتماديات", "insert": "dependencies:\n  $0: ^$1", "priority": 10 },
    { "name": "dev_dependencies", "kind": "keyword", "description": "اعتماديات التطوير", "insert": "dev_dependencies:\n  $0: ^$1", "priority": 9 },
    { "name": "flutter-sdk", "kind": "snippet", "description": "Flutter SDK", "insert": "flutter:\n  sdk: flutter", "priority": 8 },
    { "name": "cupertino_icons", "kind": "snippet", "description": "Cupertino Icons", "insert": "cupertino_icons: ^1.0.6", "priority": 7 },
    { "name": "flutter-section", "kind": "keyword", "description": "قسم Flutter", "insert": "flutter:\n  uses-material-design: true\n  assets:\n    - $0", "priority": 9 },
    { "name": "assets", "kind": "keyword", "description": "الأصول", "insert": "assets:\n  - assets/$0", "priority": 8 },
    { "name": "fonts", "kind": "keyword", "description": "الخطوط", "insert": "fonts:\n  - family: $0\n    fonts:\n      - asset: assets/fonts/$1", "priority": 7 },
    { "name": "flutter-config", "kind": "keyword", "description": "إعدادات Flutter", "insert": "flutter:\n  uses-material-design: true", "priority": 8 },

    // Docker Compose — 10
    { "name": "docker-compose", "kind": "snippet", "description": "docker-compose أساسي", "insert": "version: '3.8'\n\nservices:\n  $0:\n    image: $1\n    ports:\n      - '$2:$3'", "priority": 9 },
    { "name": "services", "kind": "keyword", "description": "الخدمات", "insert": "services:\n  $0:", "priority": 9 },
    { "name": "image", "kind": "keyword", "description": "صورة docker", "insert": "image: $0", "priority": 9 },
    { "name": "container_name", "kind": "keyword", "description": "اسم الحاوية", "insert": "container_name: $0", "priority": 7 },
    { "name": "ports", "kind": "keyword", "description": "المنافذ", "insert": "ports:\n  - '$0:$1'", "priority": 8 },
    { "name": "volumes", "kind": "keyword", "description": "المجلدات", "insert": "volumes:\n  - $0:$1", "priority": 8 },
    { "name": "environment", "kind": "keyword", "description": "متغيرات البيئة", "insert": "environment:\n  - $0=$1", "priority": 8 },
    { "name": "depends_on", "kind": "keyword", "description": "الاعتماديات", "insert": "depends_on:\n  - $0", "priority": 7 },
    { "name": "restart", "kind": "keyword", "description": "سياسة الإعادة", "insert": "restart: unless-stopped", "priority": 6 },
    { "name": "networks", "kind": "keyword", "description": "الشبكات", "insert": "networks:\n  - $0", "priority": 6 },

    // General YAML (12)
    { "name": "null", "kind": "value", "description": "قيمة فارغة", "insert": "null", "priority": 6 },
    { "name": "true", "kind": "value", "description": "صحيح", "priority": 6 },
    { "name": "false", "kind": "value", "description": "خطأ", "priority": 6 },
    { "name": "~", "kind": "value", "description": "قيمة فارغة (بديل)", "priority": 4 },
    { "name": "---", "kind": "value", "description": "بداية مستند", "priority": 5 },
    { "name": "...", "kind": "value", "description": "نهاية مستند", "priority": 4 },
    { "name": "-", "kind": "value", "description": "عنصر مصفوفة", "priority": 8 },
    { "name": "list-item", "kind": "snippet", "description": "عنصر في مصفوفة", "insert": "- $0", "priority": 9 },
    { "name": "key-value", "kind": "snippet", "description": "زوج مفتاح-قيمة", "insert": "$0: $1", "priority": 10 },
    { "name": "multi-line", "kind": "snippet", "description": "نص متعدد الأسطر", "insert": "key: |\n  $0", "priority": 7 },
    { "name": "folded", "kind": "snippet", "description": "نص مطوي", "insert": "key: >\n  $0", "priority": 6 },
    { "name": "anchor", "kind": "snippet", "description": "مرساة", "insert": "defaults: &defaults\n  $0\n\nprod:\n  <<: *defaults", "priority": 5 }
  ]
}